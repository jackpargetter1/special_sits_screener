# Identifies you to SEC EDGAR — required, or requests get 403'd.
SEC_USER_AGENT="SpecialSitsScreener jack@example.com"

# Gmail: use an app password (myaccount.google.com/apppasswords), not your real password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=
EMAIL_TO=

# Optional — override the target date (YYYY-MM-DD) instead of "yesterday". Useful
# for backfilling or testing against a day you know had activity.
RUN_DATE=2026-07-31
